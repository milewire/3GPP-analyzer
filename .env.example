# Public site URL used for canonical links, sitemap, and Open Graph.
# Example: https://3gppsniffer.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Worker API base URL. Every page reads its data from here, so the
# Worker must be reachable: `npm run worker:dev` for http://localhost:8787, or
# the deployed Worker URL in production.
NEXT_PUBLIC_API_URL=https://3gpp-sniffer-worker.phillip-smith-151.workers.dev
