# Public site URL used for canonical links, sitemap, Open Graph, and robots.txt.
# Production: https://3gppanalyzer.com
NEXT_PUBLIC_SITE_URL=https://3gppanalyzer.com

# Cloudflare Worker API base URL. Every page reads its data from here.
# Local: http://localhost:8787  (requires `npm run worker:dev`)
# Production: https://api.3gppanalyzer.com (preferred) or your Worker *.workers.dev URL
NEXT_PUBLIC_API_URL=http://localhost:8787
