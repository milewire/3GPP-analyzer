# Public site URL used for canonical links, sitemap, and Open Graph.
# Example: https://3gppsniffer.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Worker API base URL (production).
# If unset or pointing at localhost, the site uses bundled seed data so Vercel
# still shows content before the Worker is deployed.
# Example: https://3gpp-sniffer-worker.<your-subdomain>.workers.dev
NEXT_PUBLIC_API_URL=
