# Public site URL used for canonical links, sitemap, and Open Graph.
# Example: https://3gppsniffer.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Worker API base URL (required in production for live 3GPP data).
# Example: https://3gpp-sniffer-worker.<account>.workers.dev
NEXT_PUBLIC_API_URL=http://localhost:8787

