# Public site URL used for canonical links, sitemap, and Open Graph.
# Example: https://3gppsniffer.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Worker API base URL.
# In production this MUST point at the deployed Worker so the site serves live
# data. When unset (or localhost), local dev uses bundled seed data only.
NEXT_PUBLIC_API_URL=https://3gpp-sniffer-worker.phillip-smith-151.workers.dev
