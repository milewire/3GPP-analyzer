{
  "name": "3gpp-analyzer",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "worker:dev": "wrangler dev -c wrangler.local.toml",
    "worker:deploy": "wrangler deploy -c wrangler.local.toml",
    "db:create": "wrangler d1 create 3gpp-sniffer-db",
    "db:schema": "wrangler d1 execute 3gpp-sniffer-db --local --file=./schema.sql -c wrangler.local.toml",
    "db:seed": "wrangler d1 execute 3gpp-sniffer-db --local --file=./scripts/seed.sql -c wrangler.local.toml",
    "db:schema:remote": "wrangler d1 execute 3gpp-sniffer-db --remote --file=./schema.sql -c wrangler.local.toml",
    "db:seed:remote": "wrangler d1 execute 3gpp-sniffer-db --remote --file=./scripts/seed.sql -c wrangler.local.toml",
    "ingest": "node scripts/ingest.js",
    "ingest:rel19": "node scripts/ingest.js --releases=Rel-19 --series=22,23,24,29,33,36,37,38 --sql-out=scripts/ingest-out.sql --force",
    "ingest:rel20": "node scripts/ingest.js --releases=Rel-20 --all-series",
    "backfill:metadata": "node scripts/backfill-metadata.js --sql-out=scripts/backfill-out.sql",
    "extract:sources": "python scripts/extract-source-excerpts.py --sql-out=scripts/source-excerpts.sql",
    "extract:sources:key": "python scripts/extract-source-excerpts.py --key-only --limit=50 --sql-out=scripts/source-excerpts.sql"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240815.0",
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4",
    "wrangler": "^3.72.0"
  }
}
